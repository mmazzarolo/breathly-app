{
  "name": "breathly-app-expo",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "e2e": "maestro test .maestro/flows",
    "e2e:android": "maestro --platform=android test .maestro/flows",
    "e2e:ios": "maestro --platform=ios test .maestro/flows",
    "e2e:build:android": "expo run:android --variant release --no-bundler",
    "e2e:build:ios": "expo run:ios --configuration Release --no-bundler",
    "visual:capture": "bash scripts/visual-e2e/capture-installed.sh",
    "visual:compare": "node scripts/visual-e2e/compare.mjs",
    "validate:static": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "validate:expo": "expo install --check && expo-doctor",
    "validate:bundles": "expo export --platform all --output-dir dist/validate-export --clear",
    "validate": "bun run validate:static && bun run validate:expo"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "color": "^4.2.3",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "ms": "^2.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/color": "^3.0.3",
    "@types/jest": "29.5.14",
    "@types/ms": "^2.1.0",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~57.0.5",
    "expo-doctor": "^1.20.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "bun@1.3.14",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
